# Supabase（ローカル開発: `supabase start` の出力値を使用）
# ブラウザに公開されるのは NEXT_PUBLIC_ プレフィックスのみ。
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# サーバー専用。クライアントへ絶対に公開しない。通常のユーザー操作の認可には使わない。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider key はサーバー専用（Phase 4 まで未使用）。NEXT_PUBLIC_ を付けない。
# ANTHROPIC_API_KEY=
